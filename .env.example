# ==============================================================================
# MediStock — Unified Monorepo Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the repository root for local development.
# NEVER commit the root `.env` to version control.
#
# All services (Backend, Web, Agent Service) read from this single root .env.
# ==============================================================================

# ── JWT Authentication (Backend & Integration) ────────────────────────────────
JWT_ISSUER=MediStock.Api
JWT_AUDIENCE=MediStock.Client
JWT_SIGNING_KEY=HoOeYL3F2xPhZY+Px4gWS3zfbtnreq4o69ivATfKCB2lab2GSOq9PaNPcbD7VyY4vdHonz9ecREeDXh92nBYtQ==
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ASP.NET Core hierarchical naming alias (optional)
Jwt__Issuer=MediStock.Api
Jwt__Audience=MediStock.Client
Jwt__SigningKey=HoOeYL3F2xPhZY+Px4gWS3zfbtnreq4o69ivATfKCB2lab2GSOq9PaNPcbD7VyY4vdHonz9ecREeDXh92nBYtQ==
Jwt__AccessTokenExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=7

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_DB=medistock
POSTGRES_USER=medistock
POSTGRES_PASSWORD=medistock_dev_password
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=medistock;Username=medistock;Password=medistock_dev_password
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=medistock;Username=medistock;Password=medistock_dev_password

# ── Service Endpoints ─────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:5182
AGENT_SERVICE_URL=http://127.0.0.1:8000
ASPNETCORE_ENVIRONMENT=Development

# ── React Web (Vite Public Variables) ─────────────────────────────────────────
# Only VITE_ prefixed variables are bundled into the client browser build.
# Server secrets (JWT signing keys, database passwords) are never exposed to Vite.
VITE_API_URL=http://localhost:5182
VITE_AGENT_API_URL=http://127.0.0.1:8000

# ── Agent Service (Python / LangGraph) ─────────────────────────────────────────
ENVIRONMENT=development
LLM_PROVIDER=ollama
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
MEDISTOCK_API_BASE_URL=http://localhost:5182
AGENT_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=30
