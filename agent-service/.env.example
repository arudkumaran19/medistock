# ==============================================================================
# MediStock Agent Service Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in this directory (agent-service/.env).
# 2. Fill in your development secrets and configuration.
# 3. NEVER commit real secrets, API keys, or '.env' to version control!
# ==============================================================================

# Runtime Environment (development | production | test)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Choose which provider the Procurement & Policy Validation Agent should use:
# Options: 'gemini' | 'ollama'
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini

# --- Option A: Google Gemini API (Cloud) ---
# Obtain your free API key at: https://aistudio.google.com/app/apikey
# Paste your real key ONLY into 'agent-service/.env' (never commit it!)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Option B: Ollama (Local LLM) ---
# Download & install Ollama: https://ollama.com
# Run 'ollama run llama3' locally in a terminal
# Set LLM_PROVIDER=ollama to activate local mode
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# Authoritative Backend API
# Address of the MediStock ASP.NET Core Web API
# ------------------------------------------------------------------------------
MEDISTOCK_API_BASE_URL=http://localhost:5182

# ------------------------------------------------------------------------------
# Execution Timeouts (Seconds)
# ------------------------------------------------------------------------------
AGENT_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=30
