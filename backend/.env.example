# ==============================================================================
# MediStock Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` for local development.
# NEVER commit `backend/.env` — it is already in `.gitignore`.
#
# Both flat environment variables (JWT_*) and ASP.NET Core hierarchical
# environment variables (Jwt__*) are supported.
#
# Precedence:
# 1. Host environment variables (Cloud / Docker / CI)
# 2. Local `backend/.env` file
# 3. Non-secret defaults in appsettings.json
# ==============================================================================

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_ISSUER=MediStock.Api
JWT_AUDIENCE=MediStock.Client
JWT_SIGNING_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Alternative ASP.NET Core double-underscore convention (also supported):
# Jwt__Issuer=MediStock.Api
# Jwt__Audience=MediStock.Client
# Jwt__SigningKey=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
# Jwt__AccessTokenExpirationMinutes=60
# Jwt__RefreshTokenExpirationDays=7

# ── Database Connection (Optional override for development) ───────────────────
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=medistock;Username=medistock;Password=medistock_dev_password

# ── ASP.NET Core Runtime ──────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
