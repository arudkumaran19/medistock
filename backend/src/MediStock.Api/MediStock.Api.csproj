<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    SHARED HOST SCAFFOLDING - NOT owned by the Demand vertical.
    The blueprint does not assign a primary owner for the project/solution files.
    Created here only so the Demand & Shortage vertical slice compiles, runs and is testable.

    Target framework note: the blueprint's primary choice is .NET 10 (section 7).
    Only the .NET 8 SDK is available on this machine, and the blueprint stack table
    (section 6) lists ".NET 8 LTS" as the sanctioned alternative. Targeting net8.0.
    Confirm the final target framework at team level before integration.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MediStock.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

</Project>
