# Flutter operational application environment variables.
# Never commit a populated .env file.

# Base URL of the ASP.NET Core API.
# Android emulator: 10.0.2.2 is the emulator's alias for the host machine's localhost.
# Physical device:  use the development machine's LAN address, and start the API with
#                   ASPNETCORE_URLS=http://0.0.0.0:5000 so it listens beyond loopback.
API_BASE_URL=http://10.0.2.2:5000
